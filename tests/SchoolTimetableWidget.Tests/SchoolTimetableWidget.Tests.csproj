<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CoreOnlyTests Condition="'$(CoreOnlyTests)' == '' and '$(OS)' != 'Windows_NT'">true</CoreOnlyTests>
    <TargetFramework Condition="'$(CoreOnlyTests)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(CoreOnlyTests)' != 'true'">net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" Condition="'$(CoreOnlyTests)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SchoolTimetableWidget.Core\SchoolTimetableWidget.Core.csproj" />
    <ProjectReference Include="..\..\src\SchoolTimetableWidget.Desktop\SchoolTimetableWidget.Desktop.csproj" Condition="'$(CoreOnlyTests)' != 'true'" />
  </ItemGroup>

  <!-- Explicit allowlist: a passing Core-only run never claims WPF/Windows coverage. -->
  <ItemGroup Condition="'$(CoreOnlyTests)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="DataInterchange\**\*.cs" />
    <Compile Include="TimetableImport\ImporterTests.cs;TimetableImport\ImportFixtures.cs;TimetableImport\ClipboardTableTests.cs" />
    <Compile Include="Timetable\WeeklyTimetableContractTests.cs" />
    <Compile Include="Periods\CurrentPeriodContractTests.cs" />
    <Compile Include="CurrentStatus\CurrentStatusContractTests.cs;CurrentStatus\CurrentStatusCountdownContractTests.cs" />
    <Compile Include="Time\ApplicationClockContractTests.cs;Time\FakeApplicationClock.cs" />
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="DisplaySettings\profile-v1.json" /><EmbeddedResource Include="DisplaySettings\profile-v2.json" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="DisplaySettings\profile-v3.json" />
    <EmbeddedResource Include="DisplaySettings\profile-v4.json" />
    <EmbeddedResource Include="Fonts\Orbitron-Light.ttf" />
    <None Include="..\..\src\SchoolTimetableWidget.Desktop\Assets\Fonts\Orbitron-LICENSE.txt" Link="Fonts\Orbitron-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

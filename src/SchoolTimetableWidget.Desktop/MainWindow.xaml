<Window x:Class="SchoolTimetableWidget.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:currentStatus="clr-namespace:SchoolTimetableWidget.Desktop.Features.CurrentStatus"
        xmlns:backup="clr-namespace:SchoolTimetableWidget.Desktop.Features.Persistence"
        xmlns:display="clr-namespace:SchoolTimetableWidget.Desktop.Features.DisplaySettings"
        xmlns:timetable="clr-namespace:SchoolTimetableWidget.Desktop.Features.Timetable"
        xmlns:windows="clr-namespace:SchoolTimetableWidget.Desktop.Infrastructure.Windows"
        windows:WindowContentMinimum.IsEnabled="True"
        Title="School Timetable Widget" Height="600" Width="800">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="표시 설정..." InputGestureText="Ctrl+," Command="{x:Static display:DisplaySettingsCommands.Open}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="데이터 백업..." Command="{x:Static backup:BackupCommands.Backup}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="데이터 복원..." Command="{x:Static backup:BackupCommands.Restore}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid MinWidth="{Binding MinWidth, ElementName=Timetable}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <currentStatus:CurrentStatusHeaderView x:Name="StatusHeader" />
        <StackPanel Grid.Row="1">
        <TextBlock x:Name="PersistenceNotice" TextWrapping="Wrap" Padding="10" Background="#FFF4D6" Foreground="#573900" Visibility="Collapsed" />
        <Button x:Name="RecoveryButton" Content="복원 전 상태로 되돌리기" Command="{x:Static backup:BackupCommands.Recover}" HorizontalAlignment="Left" Padding="12,6" Margin="10,2" Visibility="Collapsed"/>
        </StackPanel>
        <timetable:WeeklyTimetableView x:Name="Timetable" Grid.Row="2" />
    </Grid>
</Window>

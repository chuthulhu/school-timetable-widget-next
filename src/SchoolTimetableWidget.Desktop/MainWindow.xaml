<Window x:Class="SchoolTimetableWidget.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:currentStatus="clr-namespace:SchoolTimetableWidget.Desktop.Features.CurrentStatus"
        Title="School Timetable Widget" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <currentStatus:CurrentStatusHeaderView x:Name="StatusHeader" />
        <!-- Row 1 is reserved for the future timetable; no weekday header or cells yet. -->
    </Grid>
</Window>

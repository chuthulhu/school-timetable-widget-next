<Window x:Class="SchoolTimetableWidget.Desktop.Features.PeriodScheduleEditing.PeriodScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일과 시간 편집" Width="490" Height="560" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="24시간제 HH:mm · 적용에 성공한 변경은 다시 실행해도 유지됩니다."
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="교시" />
            <TextBlock Grid.Column="1" Text="시작" />
            <TextBlock Grid.Column="2" Text="종료" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PeriodRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PeriodNumber, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="0,0,12,0" Padding="8,5"
                                     Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding PeriodNumber, StringFormat={}{0}교시 시작}" />
                            <TextBox Grid.Column="2" Padding="8,5"
                                     Text="{Binding EndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding PeriodNumber, StringFormat={}{0}교시 종료}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="ErrorMessage" Grid.Row="3" Text="{Binding ErrorText}" TextWrapping="Wrap"
                   Foreground="DarkRed" FontSize="13" Margin="0,8,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="적용" MinWidth="80" Padding="12,6" Click="Apply_Click" />
            <Button x:Name="CancelButton" Content="취소" MinWidth="80" Padding="12,6" Margin="8,0,0,0"
                    IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>

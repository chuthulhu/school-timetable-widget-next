<UserControl x:Class="SchoolTimetableWidget.Desktop.Features.Timetable.WeeklyTimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchoolTimetableWidget.Desktop.Features.Timetable"
             xmlns:import="clr-namespace:SchoolTimetableWidget.Desktop.Features.TimetableImport"
             xmlns:periods="clr-namespace:SchoolTimetableWidget.Desktop.Features.PeriodScheduleEditing"
             xmlns:backup="clr-namespace:SchoolTimetableWidget.Desktop.Features.Persistence"
             xmlns:display="clr-namespace:SchoolTimetableWidget.Desktop.Features.DisplaySettings"
             xmlns:dates="clr-namespace:SchoolTimetableWidget.Desktop.Features.DateOverrides"
             xmlns:windows="clr-namespace:SchoolTimetableWidget.Desktop.Infrastructure.Windows"
             xmlns:tray="clr-namespace:SchoolTimetableWidget.Desktop.Features.TrayLifecycle"
             FontSize="16" MinWidth="500" Background="#01000000">
    <!-- Minimal layered-window hit surface keeps empty cells interactive when their brush is zero-alpha. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static dates:DateOverrideCommands.Edit}" Executed="DateOverride_Executed" CanExecute="DateOverride_CanExecute" />
        <CommandBinding Command="{x:Static dates:DateOverrideCommands.Lunch}" Executed="Lunch_Executed" CanExecute="Lunch_CanExecute" />
        <CommandBinding Command="{x:Static periods:PeriodScheduleCommands.Edit}" Executed="PeriodSchedule_Executed" CanExecute="PeriodSchedule_CanExecute" />
        <CommandBinding Command="{x:Static import:TimetableImportCommands.School}" Executed="SchoolImport_Executed" CanExecute="Import_CanExecute" />
        <CommandBinding Command="{x:Static import:TimetableImportCommands.Canonical}" Executed="CanonicalImport_Executed" CanExecute="Import_CanExecute" />
        <CommandBinding Command="{x:Static import:TimetableImportCommands.CopyTemplate}" Executed="CopyTemplate_Executed" CanExecute="CopyTemplate_CanExecute" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static import:TimetableImportCommands.School}" />
    </UserControl.InputBindings>
    <!-- ADR 0033: the widget's single right-click menu. MainWindow shares this instance with the
         clock area and inserts the 학기 submenu at the top. Command targets are set in code-behind. -->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="시간표">
                <MenuItem Header="학교 시간표 가져오기..." InputGestureText="Ctrl+V" Command="{x:Static import:TimetableImportCommands.School}" />
                <MenuItem Header="표준 양식 가져오기..." Command="{x:Static import:TimetableImportCommands.Canonical}" />
                <Separator />
                <MenuItem Header="표준 양식 복사" Command="{x:Static import:TimetableImportCommands.CopyTemplate}" />
            </MenuItem>
            <MenuItem Header="일과">
                <MenuItem Header="일과 시간 편집..." Command="{x:Static periods:PeriodScheduleCommands.Edit}" />
                <MenuItem Header="날짜별 예외 설정..." Command="{x:Static dates:DateOverrideCommands.Edit}" />
                <Separator />
                <MenuItem x:Name="LunchMenuItem" Header="점심시간 표시 (4·5교시 사이)" IsCheckable="True"
                          Command="{x:Static dates:DateOverrideCommands.Lunch}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="표시 설정..." InputGestureText="Ctrl+," Command="{x:Static display:DisplaySettingsCommands.Open}" />
            <MenuItem Header="창">
                <MenuItem Header="창 설정..." Command="{x:Static windows:WindowPlacementCommands.Settings}" />
                <MenuItem Header="창 위치·크기 초기화" Command="{x:Static windows:WindowPlacementCommands.Reset}" />
            </MenuItem>
            <MenuItem Header="데이터">
                <MenuItem Header="백업..." Command="{x:Static backup:BackupCommands.Backup}" />
                <MenuItem Header="복원..." Command="{x:Static backup:BackupCommands.Restore}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="위치 고정" Command="{x:Static windows:WindowPlacementCommands.ToggleMoveLock}" />
            <MenuItem Header="위젯 숨기기" Command="{x:Static tray:WidgetCommands.Hide}" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <UserControl.Resources>
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource TableHeaderFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource TableHeaderSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource TableHeaderWeight}"/>
            <Setter Property="FontStyle" Value="{DynamicResource TableHeaderStyle}"/>
            <Setter Property="Foreground" Value="{DynamicResource TableHeaderTextBrush}"/>
        </Style>
        <Style x:Key="TableCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource TableCellFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource TableCellSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource TableCellWeight}"/>
            <Setter Property="FontStyle" Value="{DynamicResource TableCellStyle}"/>
            <Setter Property="Foreground" Value="{DynamicResource TableCellTextBrush}"/>
        </Style>
        <Style x:Key="WeekArrow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TableHeaderTextBrush}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5ECF3"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D1DFED"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D1DFED"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Candidate spacing only; content participates in WPF measurement. -->
        <!-- Separate rounded tiles: a 2px margin leaves a 4px gap between neighbouring cells. -->
        <Style x:Key="SlotBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource TableBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="BodySlotBorder" TargetType="Border" BasedOn="{StaticResource SlotBorder}">
            <Setter Property="Background" Value="{DynamicResource TableCellBrush}" />
            <Style.Triggers>
                <!-- Render-only candidate: no thickness, font, padding or template changes. -->
                <DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="local:TimetableCellControl">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TimetableCellControl">
                        <Grid>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <Rectangle x:Name="FocusOutline" Margin="5" Opacity="0" IsHitTestVisible="False" RadiusX="4" RadiusY="4"
                                       Stroke="{DynamicResource TableCellTextBrush}"
                                       StrokeThickness="1" StrokeDashArray="2,2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DateHeaderBorder" TargetType="Border" BasedOn="{StaticResource SlotBorder}">
            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableTodayHeaderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DateHeaderTemplate">
            <Border Style="{StaticResource DateHeaderBorder}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource TableHeaderText}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding WeekdayText}" Style="{StaticResource TableHeaderText}" Margin="0,3,0,0" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HeaderTemplate">
            <Border Style="{StaticResource SlotBorder}"
                    Background="{DynamicResource TableHeaderBrush}">
                <TextBlock Style="{StaticResource TableHeaderText}" Text="{Binding Mode=OneWay}" TextAlignment="Center"
                           VerticalAlignment="Center" TextWrapping="NoWrap" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="CornerHeader" Style="{StaticResource SlotBorder}"
                Background="{DynamicResource TableHeaderBrush}">
            <Button x:Name="PreviousWeekButton" Content="‹" Style="{StaticResource WeekArrow}" Command="{Binding PreviousWeekCommand}"
                    ToolTip="이전 주" AutomationProperties.Name="이전 주" Padding="0" MinHeight="28" />
        </Border>
        <ItemsControl x:Name="WeekdayHeaders" Grid.Column="1"
                      ItemsSource="{Binding Columns, Mode=OneWay}"
                      ItemTemplate="{StaticResource DateHeaderTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button x:Name="NextWeekButton" Grid.Column="2" Content="›" Style="{StaticResource WeekArrow}" Command="{Binding NextWeekCommand}"
                ToolTip="다음 주" AutomationProperties.Name="다음 주" Margin="2,6" Padding="0" MinHeight="28" />
        <ScrollViewer x:Name="TimetableBodyScroll" Grid.Row="1" Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      windows:WindowContentMinimum.IsOverflowHost="True"
                      CanContentScroll="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
        <ItemsControl x:Name="PeriodHeaders"
                      ItemsSource="{Binding PeriodHeaders, Mode=OneWay}"
                      ItemTemplate="{StaticResource HeaderTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="7" Columns="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl x:Name="BodyCells" Grid.Column="1"
                      ItemsSource="{Binding Cells, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="7" Columns="5" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TimetableCellControl EditRequested="Cell_EditRequested"
                                                ToolTip="더블클릭 또는 F2로 편집"
                                                AutomationProperties.Name="{Binding SlotLabel}">
                        <Border Style="{StaticResource BodySlotBorder}" MinHeight="44">
                            <TextBlock Style="{StaticResource TableCellText}" Text="{Binding DisplayText, Mode=OneWay}"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="None" />
                        </Border>
                    </local:TimetableCellControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

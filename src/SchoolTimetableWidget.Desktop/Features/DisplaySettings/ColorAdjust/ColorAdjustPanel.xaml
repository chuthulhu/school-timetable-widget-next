<UserControl x:Class="SchoolTimetableWidget.Desktop.Features.DisplaySettings.ColorAdjustPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchoolTimetableWidget.Desktop.Features.DisplaySettings"
             FontSize="13" Width="344" PreviewKeyDown="Panel_PreviewKeyDown">
    <!-- ADR 0035: in-app color adjustment window. Changes preview at once; 선택 keeps, 취소 restores. -->
    <UserControl.Resources>
        <local:RgbBrushConverter x:Key="RgbBrush"/>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Hex}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Hex}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="5" BorderBrush="#40000000" BorderThickness="1"
                                Background="{Binding Color, Converter={StaticResource RgbBrush}}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#0F6E66"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#0F6E66"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C5C5C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>
    <Border Background="White" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,12,12">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Grid x:Name="SaturationValuePad" Width="308" Height="160" Focusable="True" Cursor="Cross" ClipToBounds="True"
                  Background="{Binding HueHex}" HorizontalAlignment="Left"
                  MouseLeftButtonDown="Pad_MouseLeftButtonDown" MouseMove="Pad_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"
                  KeyDown="Pad_KeyDown"
                  AutomationProperties.Name="채도와 밝기" AutomationProperties.HelpText="방향키로 조절">
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="PadMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- The transparent background is required: without it the bar has no hit-test surface (its children are not hit-testable). -->
            <Grid x:Name="HueBar" Width="308" Height="16" Margin="0,10,0,0" Focusable="True" Cursor="SizeWE" HorizontalAlignment="Left"
                  Background="Transparent"
                  MouseLeftButtonDown="Hue_MouseLeftButtonDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"
                  KeyDown="Hue_KeyDown"
                  AutomationProperties.Name="색상" AutomationProperties.HelpText="방향키로 조절">
                <Border CornerRadius="8" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueMarker" Width="8" Height="22" Canvas.Top="-3" CornerRadius="3" BorderBrush="White" BorderThickness="2">
                        <Border.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <DockPanel Margin="0,12,0,0">
                <Border DockPanel.Dock="Right" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="5" ClipToBounds="True"
                        ToolTip="왼쪽 이전 색 · 오른쪽 새 색" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="BeforeSample" Width="28" Height="26" Fill="{Binding Before, Converter={StaticResource RgbBrush}}"/>
                        <Rectangle x:Name="CurrentSample" Width="28" Height="26" Fill="{Binding Current, Converter={StaticResource RgbBrush}}"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="HexInput" Width="92" HorizontalAlignment="Left" Padding="6,4" MaxLength="7" FontFamily="Consolas" VerticalContentAlignment="Center"
                         Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="16진수 색상 코드"/>
            </DockPanel>
            <TextBlock x:Name="HsvReadout" Text="{Binding HsvText}" Foreground="#5C5C5C" FontSize="12" Margin="0,6,0,0" TextWrapping="NoWrap"/>
            <TextBlock x:Name="HexErrorText" Text="{Binding HexError}" Foreground="#A32323" FontSize="12" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="추천 색" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
            <ItemsControl x:Name="RecommendedColors" ItemsSource="{x:Static local:ColorAdjustModel.Recommended}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Width="320"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><Button Style="{StaticResource Chip}" Click="Choice_Click"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="최근 사용" Style="{StaticResource Caption}" Margin="0,6,0,6"/>
            <ItemsControl x:Name="RecentColorChoices" ItemsSource="{Binding RecentChoices}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><Button Style="{StaticResource Chip}" Click="Choice_Click"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="아직 없습니다" Foreground="#5C5C5C" FontSize="12" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasRecent}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl x:Name="ContrastChecks" ItemsSource="{Binding Contrast}" Focusable="False" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Box" CornerRadius="6" Padding="10,7" Margin="0,0,0,6" Background="#E8F3F1">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#0F6E66" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock Text="{Binding OpacityNote}" Foreground="#5C5C5C" FontSize="12" TextWrapping="Wrap" Margin="18,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Caution">
                                <Setter TargetName="Box" Property="Background" Value="#FFF4D6"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#8A5A00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Poor">
                                <Setter TargetName="Box" Property="Background" Value="#FDECEC"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#A32323"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ContrastNote}" Foreground="#5C5C5C" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelColorButton" Content="취소" Style="{StaticResource DialogButton}" Click="Cancel_Click"/>
                <Button x:Name="ConfirmColorButton" Content="선택" Style="{StaticResource DialogButton}" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

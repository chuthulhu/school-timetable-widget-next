<Window x:Class="SchoolTimetableWidget.Desktop.Features.DisplaySettings.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontSize="14">
    <StackPanel Margin="20">
        <Label Content="프리셋 이름" Target="{Binding ElementName=NameInput}" Padding="0,0,0,8"/>
        <TextBox x:Name="NameInput" Padding="8" AutomationProperties.Name="프리셋 이름"/>
        <TextBlock Text="이름은 60자 이내로 입력해 주세요. 적용 또는 확인을 누르면 최종 저장됩니다."
                   TextWrapping="Wrap" Foreground="#555555" Margin="0,10,0,0"/>
        <TextBlock x:Name="NameError" Foreground="#A32323" TextWrapping="Wrap" Margin="0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" IsCancel="True" Click="Cancel_Click" Padding="18,7"/>
            <Button x:Name="SaveNameButton" Content="저장" IsDefault="True" Click="Save_Click" Margin="8,0,0,0" Padding="18,7"/>
        </StackPanel>
    </StackPanel>
</Window>
